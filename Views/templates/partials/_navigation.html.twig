{% set adminLinks = navigationAdmin() %}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark navbar-dark sticky-top border-bottom" id="main-nav-bar">
	<div
		class="container-fluid mx-4">

		<!-- Logo -->
		<a class="navbar-brand ms-3" href="{{ path('profil_acceuil') }}">
			<img src="{{ asset('build/images/logoHFF.jpg') }}" id="LogoHFF" alt="Logo HFF" style="height: 40px;">
		</a>

		<div class="chrono-container ms-5">
			<div class="chrono-bar">
				<div class="chrono-progress"></div>
			</div>
			<div class="chrono-text text-white" id="chrono-text">15:00</div>
		</div>

		<!-- Bouton burger -->
		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>

		<!-- Contenu -->
		<div class="collapse navbar-collapse" id="mainNavbar">
			<div
				class="d-lg-flex justify-content-between w-100 align-items-center">

				<!-- Menu utilisateur -->
				<ul class="navbar-nav ms-lg-auto">
					<li class="me-3">
						<a class="app-version" href="{{ App.base_path_fichier }}/version/Versions Intranet 2026 08 28.pdf" target="_blank" role="button">
							<i class="fas fas fa-tag"></i>
							Version: V20260828.0.0.1
						</a>
					</li>
					{# Notifications : tâches du suivi des opérations assignées à l'utilisateur : à faire aujourd'hui / en retard, et à planifier (sans échéance) #}
					{% set tachesATraiter = taches_a_traiter(App.userConnecter.username) %}
					{% set tachesAPlanifier = taches_a_planifier(App.userConnecter.username) %}
					{% set nbNotifications = tachesATraiter|length + tachesAPlanifier|length %}
					{% set aujourdhui = 'now'|date('Y-m-d') %}
					<li class="nav-item dropdown me-2">
						<a class="nav-link position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications" aria-label="Notifications ({{ nbNotifications }})">
							<i class="fas fa-bell text-white"></i>
							{% if nbNotifications > 0 %}
								<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">{{ nbNotifications }}</span>
							{% endif %}
						</a>
						<ul class="dropdown-menu dropdown-menu-end" style="min-width: 360px; max-height: 400px; overflow-y: auto;">
							{% if tachesATraiter is not empty %}
								<li class="dropdown-header">À traiter aujourd'hui</li>
								{% for tache in tachesATraiter %}
									{% set enRetard = tache.echeance|date('Y-m-d') < aujourdhui %}
									<li>
										<a class="dropdown-item small text-wrap" href="{{ path('suivi_operation_index', {vue: 'taches'}) }}#tache-{{ tache.id }}">
											<strong>Tâche n° {{ tache.id }}</strong> – {{ tache.typeOperation }} : {{ tache.etape }}
											<br><span class="{{ enRetard ? 'text-danger fw-bold' : 'text-muted' }}">{{ enRetard ? 'En retard : échéance le ' : 'Échéance le ' }}{{ tache.echeance|date('d/m/Y') }}</span>
										</a>
									</li>
								{% endfor %}
							{% endif %}
							{% if tachesAPlanifier is not empty %}
								<li class="dropdown-header">Tâches assignées à planifier</li>
								{% for tache in tachesAPlanifier %}
									<li>
										<a class="dropdown-item small text-wrap" href="{{ path('suivi_operation_index', {vue: 'taches'}) }}#tache-{{ tache.id }}">
											<strong>Tâche n° {{ tache.id }}</strong> – {{ tache.typeOperation }} : {{ tache.etape }}
											<br><span class="text-muted">Vous êtes assigné(e) : saisissez une échéance pour planifier cette tâche</span>
										</a>
									</li>
								{% endfor %}
							{% endif %}
							{% if nbNotifications == 0 %}
								<li><span class="dropdown-item-text small text-muted">Aucune notification</span></li>
							{% endif %}
							<li id="activer-alertes" class="d-none border-top mt-1 pt-1">
								<button type="button" class="dropdown-item small text-primary"><i class="fas fa-desktop me-1"></i> Activer les alertes Windows</button>
							</li>
						</ul>
					</li>
					<div id="alertes-taches" class="position-fixed bottom-0 end-0 p-3" style="z-index: 1090;"></div>
					<script>
						// alertes des tâches : interroge le serveur toutes les 90 s et prévient une seule fois par alerte (clé)
						// notification Windows si le navigateur l'autorise (HTTPS ou localhost uniquement), sinon bandeau + compteur dans le titre de l'onglet
						(function () {
							const url = "{{ path('api_suivi_operation_alertes')|e('js') }}";
							const titreOrigine = document.title;
							const notificationPossible = window.isSecureContext && 'Notification' in window;
							let nonLues = 0;

							const bouton = document.getElementById('activer-alertes');
							if (notificationPossible && Notification.permission === 'default') {
								bouton.classList.remove('d-none');
								bouton.querySelector('button').addEventListener('click', () => Notification.requestPermission().then(() => bouton.classList.add('d-none')));
							}

							function lireVues() {
								try { const v = localStorage.getItem('alertes-taches-vues'); return v === null ? null : new Set(JSON.parse(v)); } catch (e) { return new Set(); }
							}

							function bandeau(alerte) {
								const div = document.createElement('div');
								div.className = 'alert alert-danger shadow mb-2';
								const lien = document.createElement('a');
								lien.href = alerte.lien;
								lien.className = 'alert-link d-block';
								lien.textContent = alerte.titre;
								const texte = document.createElement('div');
								texte.className = 'small';
								texte.textContent = alerte.texte;
								const fermer = document.createElement('button');
								fermer.type = 'button';
								fermer.className = 'btn-close float-end';
								fermer.setAttribute('aria-label', 'Fermer');
								fermer.addEventListener('click', () => div.remove());
								div.append(fermer, lien, texte);
								document.getElementById('alertes-taches').append(div);
							}

							function prevenir(alerte) {
								if (notificationPossible && Notification.permission === 'granted') {
									const n = new Notification(alerte.titre, {body: alerte.texte, tag: alerte.cle, requireInteraction: true});
									n.onclick = () => { window.focus(); window.location.href = alerte.lien; };
								}
								bandeau(alerte);
								nonLues++;
								document.title = '(' + nonLues + ') ' + titreOrigine;
							}

							async function verifier() {
								try {
									const reponse = await fetch(url, {headers: {'X-Requested-With': 'XMLHttpRequest'}});
									if (!reponse.ok) return;
									const alertes = await reponse.json();
									const vues = lireVues();
									// premier passage sur ce navigateur : on mémorise l'existant sans tout notifier d'un coup
									alertes.forEach(a => { if (vues !== null && !vues.has(a.cle)) prevenir(a); });
									try { localStorage.setItem('alertes-taches-vues', JSON.stringify(alertes.map(a => a.cle))); } catch (e) {}
								} catch (e) {}
							}

							window.addEventListener('focus', () => { nonLues = 0; document.title = titreOrigine; });
							verifier();
							setInterval(verifier, 90000);
						})();
					</script>

					<li class="nav-item dropdown">
						<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" id="userName" data-user-full-name="{{ App.userConnecter.fullname }}" aria-expanded="false" style="color: #fbbb01;">
							<i class="fas fa-user pe-1"></i>
							{{ App.userConnecter.lastname ~ '.' ~ App.userConnecter.firstname }}
						</a>
						<ul
							class="dropdown-menu dropdown-menu-end">

							{# Menu Administrateur : affiché uniquement si au moins un groupe est accessible #}
							{% if adminLinks is not empty %}
								<li class="dropstart">
									<a class="dropdown-item dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="color: #fbbb01;">
										<i class="fas fa-shield-alt pe-2"></i>
										Administrateur
									</a>
									<ul class="dropdown-menu p-3" style="min-width: 720px;">
										<div class="row g-3">
											{% for groupe in adminLinks %}
												<div class="col-md-4">
													<li class="dropdown-header">
														<i class="fa-solid {{ groupe.icon }} me-2"></i>
														{{ groupe.header }}
													</li>
													{% for link in groupe.links %}
														<li>
															<a class="dropdown-item" href="{{ path(link.route) }}">
																<i class="fa-solid {{ link.icon }} me-2"></i>
																{{ link.label }}
															</a>
														</li>
													{% endfor %}
												</div>
											{% endfor %}
										</div>
									</ul>
								</li>
							{% endif %}

							<li>
								<a class="dropdown-item text-danger" href="{{ path('auth_deconnexion') }}" id="logoutLink">
									<i class="fas fa-power-off pe-2"></i>
									Se déconnecter
								</a>
							</li>
						</ul>
					</li>
				</ul>
			</div>
		</div>
	</div>
</nav>
