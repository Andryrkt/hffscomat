{% extends "baseTemplate.html.twig" %}

{% block title %}
	Magasin - Soumission commandes fournisseur à génerer
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/list.css?v=2025.10.22.08.00">
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/new.css?v=2025.10.22.08.00">
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/magasin/magasin.css?v=2025.10.22.08.00">
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/magasin/soumissionCommande.css?v=2025.10.22.08.00">
{% endblock %}


{% block content %}
	<div class="container-spaced mt-6 mb-4">
		<div class="card p-4 soumission-page">
			<h3 class="perso-titre">Soumission commandes fournisseur à génerer</h3>
			{% include "/partials/_notification.html.twig" %}
			{{ form_start(form, {'attr': {'id': 'myForm', 'enctype': 'multipart/form-data'}}) }}
			{{ form_errors(form) }}
			<div class="row my-2 align-items-center">
				<div class="col-md-4">
					<div class="row align-items-center">
						{{ form_label(form.numCmde) }}
						<div class="col-6">
							{{ form_widget(form.numCmde) }}
						</div>
						<div class="col-6">
							<button type="button" class="btn bouton-brouillon border text-black" id="genererPdf">
								<i class="fa-solid fa-file-pdf"></i>
								Générer PDF
							</button>
						</div>
					</div>
				</div>
				<div id="pj-section" class="col-md-8 d-none">
					{% include '/partials/_dropZonePdfMultiple.html.twig' with {'id': '2', 'form': form, 'fieldName': 'piecesJointesPdf', 'classBtn': 'btn-warning'} %}
				</div>
			</div>
			<div id="viewer-container" class="d-none">
				<div id="file-viewer">
					<ul class="nav nav-tabs" role="tablist">
						<li class="nav-item" role="presentation">
							<button class="nav-link active fs-6" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab">
								Commande à valider
								<span id="badge-cmde" class="tab-badge bg-danger text-white d-none" aria-live="polite"></span>
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link fs-6" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2" type="button" role="tab">
								Pièces jointes
								<span id="badge-pj" class="tab-badge bg-danger text-white d-none" aria-live="polite"></span>
							</button>
						</li>
					</ul>
					<div class="tab-content border border-top-0 p-3">
						<div class="tab-pane fade show active" id="tab1" role="tabpanel">
							<div class="position-relative w-100 border rounded overflow-hidden" style="height:1000px;">
								<iframe id="pdf-iframe" name="pdf-iframe" src="" class="position-absolute top-0 start-0 w-100 h-100 border-0"></iframe>
							</div>
						</div>
						<div class="tab-pane fade" id="tab2" role="tabpanel">
							<div class="d-flex justify-content-end">
								<button type="button" id="clear-all-2" class="btn btn-sm btn-outline-danger" hidden>
									<i class="fa-solid fa-trash"></i>
									Tout supprimer
								</button>
							</div>
							<div id="file-list-2" class="mt-3"></div>
						</div>
					</div>
				</div>
			</div>
			<div class="d-flex justify-content-end mt-2">
				<button type="submit" class="bouton-principal" id="validationBtn" style="display:none ;">
					<i class="fas fa-paper-plane"></i>
					Soumettre à validation
				</button>
			</div>
			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}

{% block javascript %}
	<script src="{{ App.base_path }}/Views/js/magasin/commande/soumissionCommandeFournisseur.js?v=2025.10.22.08.00" type="module"></script>
{% endblock %}
