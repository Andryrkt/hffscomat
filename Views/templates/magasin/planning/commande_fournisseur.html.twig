{% extends "baseTemplate.html.twig" %}

{% block title %}
	Planning Commande Fournisseur
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/utils/autocomplete.css?v=2026.08.06.1">
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/list.css?v=2026.08.06.1">
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/magasin/planning/planning.css?v=2026.08.06.1">
{% endblock %}

{% block overlay %}
	{% include "/shared/_overlay.html.twig" %}
{% endblock %}

{% block content %}
	<div class="sticky-header-titre">
		<div class="container">
			{% include "/magasin/planning/_formulaire_commande_fournisseur.html.twig" %}
		</div>
	</div>
	<div class="container-fluid">
		<table class="table table-sticky">
			<thead class="table-dark">
				<tr>
					<th>Fournisseur</th>
					<th>Agence / Service</th>
					<th>Code Fourn.</th>
					{% for month in uniqueMonths %}
						<th class="{{ month.current ? 'bg-warning text-dark' : '' }}">
							{{ month.month|upper }}
							{{ month.year }}
						</th>
					{% endfor %}
				</tr>
			</thead>
			<tbody>
				{% for item in preparedData %}
					<tr>
						<td class="text-start">{{ item.fournisseur }}</td>
						<td>{{ item.agenceService }}</td>
						<td>{{ item.codeFourn }}</td>
						{% for month in uniqueMonths %}
							<td>
								{% set commandes = item.commandes[month.key]|default([]) %}
								{% if commandes|length > 0 %}
									{% for commande in commandes %}
										<a href="#" data-bs-toggle="modal" data-bs-target="#listeLigneCommandeMagasin" style="cursor: pointer;" data-id="{{ commande.numero }}" data-emetteur="{{ item.fournisseur }}" class="d-inline-block px-2 pt-1 my-1 rounded text-wrap {{ commande.classeStatut }} {{ commande.backOrder }}" title="{{ commande.statut }}">
											{{ commande.numero }}
										</a><br>
									{% endfor %}
								{% else %}
									-
								{% endif %}
							</td>
						{% endfor %}
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

	<!-- FIN tableau -->
	{# body modal #}
	{% include "/magasin/planning/_modal_commande_fournisseur.html.twig" %}
{% endblock %}

{% block javascript %}
	<script src="{{ App.base_path }}/Views/js/utils/positionSticky.js?v=2026.08.06.1"></script>
	<script src="{{ App.base_path }}/Views/js/magasin/planning/planning.js?v=2026.08.06.1" type="module"></script>
	<script src="{{ App.base_path }}/Views/js/magasin/planning/modal.js?v=2026.08.06.1" type="module"></script>
{% endblock %}
