<div class="modal fade" tabindex="-1" id="listeLigneCommandeMagasin" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-scrollable modal-xl">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">
					Listes lignes de commande
					<small class="text-success d-block mt-auto" id="orIntv" style="font-size: 0.7em; font-weight: bold;"></small>
				</h5>

				<div class="ms-auto d-flex align-items-center">
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
			</div>
			{# body du modal#}
			<div class="modal-body">
				<div class="mb-3">
					<small style="color: #c8ad7f">DISPO STOCK |</small>
					<small class="text-danger">Back Order / Error |</small>
					<small style="color: #9ACD32">Commande envoyée fournisseur |</small>
					<small class="text-warning">Réception Partielle</small>
				</div>
				<!-- Spinner de chargement -->
				<div id="loading" class="text-center">
					<div class="spinner-border" role="status">
						<span class="visually-hidden">Chargement...</span>
					</div>
				</div>

				<!-- Contenu des données -->
				<div id="dataContent" style="display: none;">
					<table class="table rounded mt-1">
						<thead class="table">
							<tr id="planningTableHead"></tr>
						</thead>
						<tbody id="commandesTableBody"></tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
