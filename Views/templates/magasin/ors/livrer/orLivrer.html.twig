{% extends "baseTemplate.html.twig" %}

{% block title %}Magasin - Liste des OR à livrer
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/list.css?v=2025.10.22.08.00">
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/magasin/magasin.css?v=2025.10.22.08.00">
{% endblock %}


{% block content %}
	<div id="conteneur" data-page-type="or_a_livrer" class="mt-6">
		<div class="container">
			<h3 class="perso-titre">
				Liste des OR à livrer
			</h3>
			{% include "/magasin/ors/livrer/_formulaireRechercheListeOrALivrer.html.twig" %}
		</div>
		<div class="container">
			<div class="d-flex justify-content-between">
				<div>
					<a href="{{path("export_liste_or_livrer")}}" class="btn btn bg-success text-white my-3 fw-bold">
						<i class="fas fa-table"></i>
						Excel
					</a>
				</div>
			</div>
		</div>

		<div class="container-fluid">
			<div class="table-responsive" style="max-height: 70vh; overflow-y: auto;">
				<table class="table rounded table-plein-ecran">
					<thead class="table-dark sticky-top">
						<tr>
							<th>
								<i class="fas fa-ellipsis-vertical"></i>
							</th>
							<th class="text-center">N° DIT</th>
							<th class="text-center">N° OR</th>
							<th>Date planning</th>
							<th>Niv. d'urg</th>
							<th>Date  OR</th>
							<th class="text-center">Agence Emetteur</th>
							<th class="text-center">Service Emetteur</th>
							<th class="text-center">Agence débiteur</th>
							<th class="text-center">Service débiteur</th>
							<th class="text-center">N° ITV</th>
							<th class="text-center">N° lig</th>
							<th>CST</th>
							<th>Réf</th>
							<th>Désignation</th>
							<th class="text-center">Qté demandée</th>
							<th class="text-center">Qté à livrer</th>
							<th class="text-center">Qté déjà livrée</th>
							<th>Utilisateur</th>
						</tr>
					</thead>
					<tbody id="tableBody">
						{% for item in data %}
							<tr>
								<td class="" style="vertical-align: middle">
									<div class="dropdown">
										<div type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
											<i class="fas fa-ellipsis-vertical"></i>
										</div>
										<ul class="dropdown-menu dropdown-menu-end" id="dropdown-menu" aria-labelledby="dropdownMenuButton" style="">
											<li>
												{% if item.referenceDit is not empty %}
													<a class="dropdown-item fw-bold" target="_blank" href="{{ path('dw_interv_ate_avec_dit', {'numDit': item.referenceDit}) }}">
														Dossier DIT
													</a>
												{% endif %}
											</li>
										</ul>
									</div>
								</td>
								<td class="fw-bold ">{{ item.referenceDit }}</td>
								<td class="fw-bold ">{{ item.numeroOr }}</td>
								<td>{{ item.datePlanningFormatee }}</td>
								<td class="">{{ item.niveauUrgence }}</td>
								<td class="">{{ item.dateCreationFormatee }}</td>
								<td class="text-center">{{ item.agenceCrediteur }}</td>
								<td class="text-center">{{ item.serviceCrediteur }}</td>
								<td class="text-center">{{ item.agenceDebiteur }}</td>
								<td class="text-center">{{ item.serviceDebiteur }}</td>
								<td class="text-center">{{ item.numeroInterventionFormate }}</td>
								<td class="text-center {{ item.classeLigne }}">{{ item.numeroLigne }}</td>
								<td class="{{ item.classeLigne }}">{{ item.constructeur }}</td>
								<td class="{{ item.classeLigne }}">{{ item.referencePiece }}</td>
								<td class="{{ item.classeLigne }}">{{ item.designation }}</td>
								<td class="text-center {{ item.classeLigne }}">{{ item.quantiteDemandeeFormatee }}</td>
								<td class="text-center {{ item.classeLigne }}">{{ item.quantiteALivrerFormatee }}</td>
								<td class="text-center">{{ item.quantiteLivreeFormatee }}</td>
								<td>{{ item.nomPrenom }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>

		<!-- FIN tableau -->
		{% include "/partials/_modalNiveauUrgence.html.twig"  %}
	</div>
{% endblock %}
{% block javascript %}
	<script src="{{ App.base_path }}/Views/js/magasin/main.js?v=2025.10.22.08.00" type="module"></script>
{% endblock %}
