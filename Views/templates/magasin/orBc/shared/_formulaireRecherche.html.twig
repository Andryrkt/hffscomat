{% import "macroForm.html.twig" as macroForm %}
<!-- DEBUT recherche -->
<div class="accordion" id="formAccordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button enteteAccordion" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                Formulaire de recherche
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#formAccordion">
            <div class="accordion-body">
                {{ form_start(form, {'method': 'GET'}) }}
                <div class="row">
                    <div class="col-12 col-md-2">
                        {{ form_row(form.dateDebut) }}
                    </div>
                    <div class="col-12 col-md-2">
                        {{ form_row(form.dateFin) }}
                    </div>
                    <div class="col-12 col-md-2">
                        {{ form_row(form.type_doc) }}
                    </div>
                    <div class="col-12 col-md-2">
                        {{ form_row(form.constructeur) }}
                    </div>
                    <div class="col-12 col-md-2">
                        {{ form_row(form.reference) }}
                    </div>
                    <div class="col-12 col-md-2">
                        {{ form_row(form.numero_doc) }}
                    </div>


                </div>

                <div class="d-flex justify-content-end mb-2 gap-2">
                    <a href="{{ path('magasin_commande_a_traiter_liste', { reset: 1 }) }}"
                        class="btn btn-secondary">
                        Effacer
                    </a>
                    <button class="btn btn-warning fw-bold" type="submit">
                        <i class="fab fa-searchengin"></i>
                        Recherche
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
<!-- FIN recherche -->