{% extends "baseTemplate.html.twig" %}

{% block title %}
    Liste des commandes à traiter
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ App.base_path }}/Views/css/list.css?v=2025.09.15.08.00">
    <link rel="stylesheet" href="{{ App.base_path }}/Views/css/magasin/orBc/list.css?v=2025.09.15.08.00">
{% endblock %}


{% block content %}
    <div class="sticky-header-titre">
        <div class="container">
            {% include "/magasin/orBc/shared/_formulaireRecherche.html.twig" %}
            {% include "/magasin/orBc/shared/_pagination.html.twig" %}
        </div>
    </div>

    <!-- DEBUT tableau -->
    <div class="container-fluid">
        <table class="table table-sticky">
            <thead class="table-dark align-middle">
                <tr>
                    <th>Type / N°</th>
                    <th>Date OR / BC</th>
                    <th>Constructeur</th>
                    <th>Référence</th>
                    <th>Désignation</th>
                    <th>Qté demandée</th>
                    <th>Qté reliquat</th>
                    <th>Qté réservée / à livrer</th>
                    <th>Date allocation</th>
                </tr>
            </thead>
            <tbody>
                {% for item in data %}
                    <tr>
                        <td>
                            {% if item.type_doc == 'OR' %}
                                <span class="badge-type-or">{{ item.type_doc }}</span>
                            {% else %}
                                <span class="badge-type-bc">{{ item.type_doc }}</span>
                            {% endif %}
                            {{ item.numero_doc }}
                        </td>

                        <td>{{ item.date|date('d/m/Y') }}</td>
                        <td>{{ item.constructeur }}</td>
                        <td>{{ item.reference }}</td>
                        <td>{{ item.designation }}</td>
                        <td>{{ item.qte_demandee|number_format(0, ',', ' ') }}</td>
                        <td >{{ item.qte_reliquat|number_format(0, ',', ' ') }}</td>
                        <td>{{ item.qte_reservee|number_format(0, ',', ' ') }}</td>
                        <td>{{ item.date_alloc is not null ? item.date_alloc|date('d/m/Y') : '-' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% include "/partials/_pagination.html.twig" %}
    <!-- FIN tableau -->
{% endblock %}

{% block javascript %}
    <script src="{{ App.base_path }}/Views/js/utils/positionSticky.js?v=2025.09.15.08.00"></script>
    <script src="{{ App.base_path }}/Views/js/magasin/orBc/listCmdeATraiter.js?v=2025.09.15.08.00" type="module"></script>
{% endblock %}
