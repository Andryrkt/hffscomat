                <!-- Contenu des données -->
                <div id="dataContentStatutDevis" style="display: none;">
                    <table class="table rounded mt-1">
                        <thead class="table">
                            <tr>
                                <th>Numéro devis</th>
                                <th>Type</th>
                                <th>Statut</th>
                                <th>Remarque magasin</th>
                                <th>Date maj</th>
                            </tr>
                        </thead>
                        <tbody id="statutDevisBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
