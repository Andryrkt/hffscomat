{% import "macroForm.html.twig" as macroForm %}
<div class="accordion" id="formAccordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button enteteAccordion" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                Formulaire de recherche
            </button>
        </h2>
        {# Ajout de la classe 'show' pour que le formulaire soit ouvert par défaut #}
        <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#formAccordion">
            <div class="accordion-body">
                {{ form_start(form, {'method': 'GET'}) }}
                <div class="row">
                    {# Colonne 1 #}
                    <div class="col-12 col-md-2">
                        {{ form_row(form.fenetreAllocation) }}
                    </div>


                    {# Colonne 2 #}
                    <div class="col-12 col-md-2">
                        {{ form_row(form.leadTimeDu) }}
                        {{ form_row(form.leadTimeAu) }}
                    </div>

                    {# Colonne 3 #}
                    <div class="col-12 col-md-2">
                        {{ form_row(form.client) }}
                    </div>

                    {# Colonne 4 #}
                    <div class="col-12 col-md-2">
                        {{ form_row(form.referenceClient) }}
                    </div>

                    {# Colonne 5 #}
                    <div class="col-12 col-md-2">
                        {{ form_row(form.typeOr) }}
                    </div>

                    {# Colonne 6 #}
                    <div class="col-12 col-md-2">
                        {{ form_row(form.numOr) }}
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-3 mb-2 gap-2">
                    <a href="{{ path('or_csa_a_traiter_liste', {'reset': 1}) }}"
                        class="btn btn-outline-secondary"
                        id="btn-reset-search">
                        <i class="bi bi-eraser"></i>
                        Effacer
                    </a>
                    <button class="btn btn-warning fw-bold" type="submit">
                        <i class="fab fa-searchengin"></i>
                        Recherche
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>